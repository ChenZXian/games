<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/cst_bg_main">

	<com.android.boot.ui.GameView
		android:id="@+id/game_view"
		android:layout_width="match_parent"
		android:layout_height="match_parent" />

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_gravity="bottom"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:padding="@dimen/cst_pad_12">

		<Button
			android:id="@+id/btn_left"
			style="@style/Widget.Game.Button.Secondary"
			android:layout_width="110dp"
			android:layout_height="54dp"
			android:text="LEFT" />

		<Button
			android:id="@+id/btn_right"
			style="@style/Widget.Game.Button.Secondary"
			android:layout_width="110dp"
			android:layout_height="54dp"
			android:layout_marginStart="@dimen/cst_pad_8"
			android:text="RIGHT" />

		<View
			android:layout_width="0dp"
			android:layout_height="1dp"
			android:layout_weight="1" />

		<Button
			android:id="@+id/btn_roll"
			style="@style/Widget.Game.Button.Primary"
			android:layout_width="110dp"
			android:layout_height="54dp"
			android:text="ROLL" />

		<Button
			android:id="@+id/btn_reset"
			style="@style/Widget.Game.Button.Primary"
			android:layout_width="110dp"
			android:layout_height="54dp"
			android:layout_marginStart="@dimen/cst_pad_8"
			android:text="RESET" />
	</LinearLayout>

	<LinearLayout
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="top|end"
		android:orientation="horizontal"
		android:padding="@dimen/cst_pad_12">

		<ImageButton
			android:id="@+id/btn_help"
			android:layout_width="44dp"
			android:layout_height="44dp"
			android:background="@android:color/transparent"
			android:contentDescription="Help"
			android:src="@drawable/ic_help" />

		<ImageButton
			android:id="@+id/btn_mute"
			android:layout_width="44dp"
			android:layout_height="44dp"
			android:layout_marginStart="@dimen/cst_pad_6"
			android:background="@android:color/transparent"
			android:contentDescription="Mute"
			android:src="@drawable/ic_sound_on" />
	</LinearLayout>

	<LinearLayout
		android:id="@+id/start_overlay"
		android:layout_width="360dp"
		android:layout_height="wrap_content"
		android:layout_gravity="center"
		android:background="@color/cst_panel_bg"
		android:orientation="vertical"
		android:padding="@dimen/cst_pad_16">

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/start_title"
			android:textColor="@color/cst_text_primary"
			android:textSize="@dimen/cst_text_l" />

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/cst_pad_8"
			android:text="@string/start_subtitle"
			android:textColor="@color/cst_text_secondary"
			android:textSize="@dimen/cst_text_m" />

		<Button
			android:id="@+id/btn_start_game"
			style="@style/Widget.Game.Button.Primary"
			android:layout_width="match_parent"
			android:layout_height="54dp"
			android:layout_marginTop="@dimen/cst_pad_12"
			android:text="@string/start_game" />
	</LinearLayout>
</FrameLayout>
