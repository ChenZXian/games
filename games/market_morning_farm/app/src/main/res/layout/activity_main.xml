<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cst_bg_main">

    <com.android.boot.ui.MarketGameView
        android:id="@+id/game_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/hud_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cst_hud_height"
        android:layout_gravity="top"
        android:background="@drawable/ui_panel_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/cst_pad_8"
        android:paddingRight="@dimen/cst_pad_8">

        <TextView
            android:id="@+id/day_time_text"
            style="@style/TextAppearance.Game.HudValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Day 1  180s" />

        <TextView
            android:id="@+id/revenue_text"
            style="@style/TextAppearance.Game.HudValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Coins 0/120" />

        <TextView
            android:id="@+id/reputation_text"
            style="@style/TextAppearance.Game.HudValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="right"
            android:text="Rep 5" />

        <Button
            android:id="@+id/pause_button"
            style="@style/Widget.Game.Button.Icon"
            android:layout_width="@dimen/cst_hud_icon_size"
            android:layout_height="@dimen/cst_hud_icon_size"
            android:text="II" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/seed_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/ui_panel_header"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="@dimen/cst_pad_6">

        <Button android:id="@+id/seed_carrot" style="@style/Widget.Game.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Carrot" />
        <Button android:id="@+id/seed_tomato" style="@style/Widget.Game.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Tomato" />
        <Button android:id="@+id/seed_corn" style="@style/Widget.Game.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Corn" />
        <Button android:id="@+id/seed_berry" style="@style/Widget.Game.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Berry" />
        <Button android:id="@+id/seed_pumpkin" style="@style/Widget.Game.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Pumpkin" />
        <Button android:id="@+id/seed_herb" style="@style/Widget.Game.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Herb" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menu_panel"
        style="@style/Widget.Game.Panel"
        android:layout_width="420dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <TextView style="@style/TextAppearance.Game.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Market Morning Farm" />
        <TextView style="@style/TextAppearance.Game.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="@dimen/cst_pad_8" android:text="Grow, stock, price, and delight the morning crowd." />
        <Button android:id="@+id/start_button" style="@style/Widget.Game.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/btn_start" />
        <Button android:id="@+id/how_button" style="@style/Widget.Game.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/btn_how_to_play" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pause_panel"
        style="@style/Widget.Game.Panel"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView style="@style/TextAppearance.Game.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Paused" />
        <Button android:id="@+id/resume_button" style="@style/Widget.Game.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/btn_resume" />
        <Button android:id="@+id/restart_button" style="@style/Widget.Game.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/btn_restart" />
        <Button android:id="@+id/menu_button" style="@style/Widget.Game.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/btn_menu" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/result_panel"
        style="@style/Widget.Game.Panel"
        android:layout_width="400dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView android:id="@+id/result_title" style="@style/TextAppearance.Game.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Day Complete" />
        <TextView android:id="@+id/result_body" style="@style/TextAppearance.Game.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="@dimen/cst_pad_8" android:text="Coins 0" />
        <Button android:id="@+id/upgrade_button" style="@style/Widget.Game.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/btn_upgrades" />
        <Button android:id="@+id/next_day_button" style="@style/Widget.Game.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/btn_next_day" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/upgrade_panel"
        style="@style/Widget.Game.Panel"
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView style="@style/TextAppearance.Game.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Market Upgrades" />
        <TextView android:id="@+id/upgrade_status" style="@style/TextAppearance.Game.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="@dimen/cst_pad_8" android:text="Coins 0" />
        <Button android:id="@+id/upgrade_plot" style="@style/Widget.Game.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Plot Speed" />
        <Button android:id="@+id/upgrade_crate" style="@style/Widget.Game.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Crate Space" />
        <Button android:id="@+id/upgrade_shelf" style="@style/Widget.Game.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Shelf Appeal" />
        <Button android:id="@+id/upgrade_water" style="@style/Widget.Game.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Watering Can" />
        <Button android:id="@+id/close_upgrade" style="@style/Widget.Game.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/btn_next_day" />
    </LinearLayout>
</FrameLayout>
