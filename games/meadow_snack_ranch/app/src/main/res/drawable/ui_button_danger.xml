<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/cst_danger" />
            <corners android:radius="@dimen/cst_radius_l" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/cst_danger" />
            <stroke android:width="@dimen/cst_stroke_s" android:color="@color/cst_panel_bg" />
            <corners android:radius="@dimen/cst_radius_l" />
        </shape>
    </item>
</selector>
