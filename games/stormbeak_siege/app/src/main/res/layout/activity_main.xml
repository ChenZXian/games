<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cst_bg_main"
    android:orientation="vertical"
    android:padding="@dimen/cst_pad_12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/cst_hud_height"
        android:background="@drawable/ui_panel_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/cst_pad_12"
        android:paddingEnd="@dimen/cst_pad_12">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/titleView"
                style="@style/TextAppearance.Game.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stormbeak Siege" />

            <TextView
                android:id="@+id/subtitleView"
                style="@style/TextAppearance.Game.HudLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cliff Nest 1  Clear air" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusBirdsView"
            style="@style/Widget.Game.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Birds 0" />

        <TextView
            android:id="@+id/statusStarsView"
            style="@style/Widget.Game.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cst_pad_8"
            android:text="Score 0" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/gameFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/cst_pad_10"
        android:layout_marginBottom="@dimen/cst_pad_10"
        android:layout_weight="1"
        android:background="@drawable/ui_panel">

        <com.android.boot.ui.GameView
            android:id="@+id/gameView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/menuOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/ui_dialog"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/cst_pad_20">

            <TextView
                style="@style/TextAppearance.Game.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stormbird Assault" />

            <TextView
                android:id="@+id/menuInfoView"
                style="@style/TextAppearance.Game.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cst_pad_8"
                android:gravity="center"
                android:text="Launch elemental birds, trigger air skills, and collapse floating fortresses." />

            <Button
                android:id="@+id/startButton"
                style="@style/Widget.Game.Button.Primary"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cst_pad_16"
                android:text="@string/btn_start" />

            <Button
                android:id="@+id/helpButton"
                style="@style/Widget.Game.Button.Secondary"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cst_pad_10"
                android:text="@string/btn_how_to_play" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/helpOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/ui_dialog"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/cst_pad_20"
            android:visibility="gone">

            <TextView
                style="@style/TextAppearance.Game.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="How To Play" />

            <TextView
                android:id="@+id/helpBodyView"
                style="@style/TextAppearance.Game.Body"
                android:layout_width="320dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cst_pad_8"
                android:gravity="center"
                android:text="Drag back and release to fire." />

            <Button
                android:id="@+id/helpCloseButton"
                style="@style/Widget.Game.Button.Primary"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cst_pad_16"
                android:text="@string/btn_resume" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pauseOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/ui_dialog"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/cst_pad_20"
            android:visibility="gone">

            <TextView
                style="@style/TextAppearance.Game.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Siege Paused" />

            <TextView
                android:id="@+id/pauseStageView"
                style="@style/TextAppearance.Game.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cst_pad_8"
                android:text="Storm Bridge 2" />

            <TextView
                android:id="@+id/pauseBodyView"
                style="@style/TextAppearance.Game.Body"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cst_pad_8"
                android:gravity="center"
                android:text="Resume when you are ready to relaunch." />

            <Button
                android:id="@+id/resumeButton"
                style="@style/Widget.Game.Button.Primary"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cst_pad_16"
                android:text="@string/btn_resume" />

            <Button
                android:id="@+id/pauseRestartButton"
                style="@style/Widget.Game.Button.Secondary"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cst_pad_10"
                android:text="@string/btn_restart" />

            <Button
                android:id="@+id/pauseMenuButton"
                style="@style/Widget.Game.Button.Secondary"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cst_pad_10"
                android:text="@string/btn_menu" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/resultOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/ui_dialog"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/cst_pad_20"
            android:visibility="gone">

            <TextView
                android:id="@+id/resultTitleView"
                style="@style/TextAppearance.Game.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fortress Broken" />

            <TextView
                android:id="@+id/resultBodyView"
                style="@style/TextAppearance.Game.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cst_pad_8"
                android:gravity="center"
                android:text="Stars 0  Score 0" />

            <Button
                android:id="@+id/nextButton"
                style="@style/Widget.Game.Button.Primary"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cst_pad_16"
                android:text="@string/btn_next" />

            <Button
                android:id="@+id/resultMenuButton"
                style="@style/Widget.Game.Button.Secondary"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cst_pad_10"
                android:text="@string/btn_menu" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:background="@drawable/ui_panel_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/cst_pad_10"
        android:paddingEnd="@dimen/cst_pad_10">

        <Button
            android:id="@+id/restartButton"
            style="@style/Widget.Game.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_restart" />

        <Button
            android:id="@+id/pauseButton"
            style="@style/Widget.Game.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cst_pad_8"
            android:text="@string/btn_pause" />

        <Button
            android:id="@+id/muteButton"
            style="@style/Widget.Game.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cst_pad_8"
            android:text="@string/btn_mute" />

        <Button
            android:id="@+id/menuButton"
            style="@style/Widget.Game.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cst_pad_8"
            android:text="@string/btn_menu" />

        <TextView
            android:id="@+id/objectiveView"
            style="@style/TextAppearance.Game.HudValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cst_pad_12"
            android:layout_weight="1"
            android:text="Objective" />
    </LinearLayout>
</LinearLayout>
