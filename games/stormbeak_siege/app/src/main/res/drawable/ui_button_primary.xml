<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="@dimen/cst_radius_m" />
            <gradient
                android:angle="270"
                android:endColor="@color/cst_btn_primary_bg_start"
                android:startColor="@color/cst_btn_primary_bg_end" />
            <stroke
                android:width="@dimen/cst_stroke_s"
                android:color="@color/cst_btn_primary_stroke" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/cst_radius_m" />
            <gradient
                android:angle="270"
                android:endColor="@color/cst_btn_primary_bg_end"
                android:startColor="@color/cst_btn_primary_bg_start" />
            <stroke
                android:width="@dimen/cst_stroke_s"
                android:color="@color/cst_btn_primary_stroke" />
        </shape>
    </item>
</selector>
