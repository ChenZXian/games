<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cst_bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/cst_pad_8">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/cst_hud_height"
            android:background="@drawable/ui_winch_beam"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hud_score"
                style="@style/Widget.Game.Badge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Score 0"
                android:textAppearance="@style/TextAppearance.Game.HudValue" />

            <TextView
                android:id="@+id/hud_timer"
                style="@style/Widget.Game.Badge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/cst_pad_8"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Time 90"
                android:textAppearance="@style/TextAppearance.Game.HudValue" />

            <TextView
                android:id="@+id/hud_stage"
                style="@style/Widget.Game.Badge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/cst_pad_8"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Stage 1"
                android:textAppearance="@style/TextAppearance.Game.HudValue" />

            <Button
                android:id="@+id/pause_button"
                style="@style/Widget.Game.Button.Icon"
                android:layout_width="@dimen/cst_hud_icon_size"
                android:layout_height="@dimen/cst_hud_icon_size"
                android:layout_marginLeft="@dimen/cst_pad_8"
                android:background="@drawable/ui_button_icon"
                android:text="II" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/cst_pad_8"
            android:layout_weight="1"
            android:orientation="horizontal">

            <com.android.boot.ui.GameView
                android:id="@+id/game_view"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/ui_cavern_viewport" />

            <LinearLayout
                android:id="@+id/tool_rail"
                android:background="@drawable/ui_tool_pocket"
                android:layout_width="148dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/cst_pad_8"
                android:gravity="center"
                android:padding="@dimen/cst_pad_10"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Tools"
                    android:textAppearance="@style/TextAppearance.Game.Subtitle" />

                <Button
                    android:id="@+id/tool_dynamite"
                    style="@style/Widget.Game.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cst_pad_8"
                    android:text="@string/btn_dynamite" />

                <Button
                    android:id="@+id/tool_magnet"
                    style="@style/Widget.Game.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cst_pad_8"
                    android:text="@string/btn_magnet" />

                <Button
                    android:id="@+id/tool_boost"
                    style="@style/Widget.Game.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cst_pad_8"
                    android:text="@string/btn_boost" />

                <Button
                    android:id="@+id/tool_lens"
                    style="@style/Widget.Game.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cst_pad_8"
                    android:text="@string/btn_lens" />

                <Button
                    android:id="@+id/tool_shield"
                    style="@style/Widget.Game.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cst_pad_8"
                    android:text="@string/btn_shield" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/order_text"
            android:background="@drawable/ui_order_rail"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="@dimen/cst_pad_8"
            android:gravity="center"
            android:text="Orders"
            android:textColor="@color/cst_order_text"
            android:textAppearance="@style/TextAppearance.Game.Body" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menu_panel"
        style="@style/Widget.Game.Panel"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Crystal Cavern Hook"
            android:textAppearance="@style/TextAppearance.Game.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cst_pad_8"
            android:gravity="center"
            android:text="Launch the claw, bend through prism gates, pull order targets, and avoid shatter hazards."
            android:textAppearance="@style/TextAppearance.Game.Body" />

        <Button
            android:id="@+id/start_button"
            style="@style/Widget.Game.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cst_pad_16"
            android:text="@string/btn_start" />

        <Button
            android:id="@+id/how_button"
            style="@style/Widget.Game.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cst_pad_8"
            android:text="@string/btn_how_to_play" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pause_panel"
        style="@style/Widget.Game.Panel"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Paused"
            android:textAppearance="@style/TextAppearance.Game.Title" />

        <Button
            android:id="@+id/resume_button"
            style="@style/Widget.Game.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cst_pad_16"
            android:text="@string/btn_resume" />

        <Button
            android:id="@+id/menu_button"
            style="@style/Widget.Game.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cst_pad_8"
            android:text="@string/btn_menu" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/result_panel"
        style="@style/Widget.Game.Panel"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/result_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Result"
            android:textAppearance="@style/TextAppearance.Game.Title" />

        <TextView
            android:id="@+id/result_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cst_pad_8"
            android:gravity="center"
            android:text="Summary"
            android:textAppearance="@style/TextAppearance.Game.Body" />

        <Button
            android:id="@+id/restart_button"
            style="@style/Widget.Game.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cst_pad_16"
            android:text="@string/btn_restart" />
    </LinearLayout>
</FrameLayout>
