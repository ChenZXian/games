{
  "version": 1,
  "game_id": "ring_prefecture_clash",
  "status": "integrated",
  "camera_perspective": "top_down",
  "default_coordinate_space": "world_space_pixels",
  "theme": "bright atlas conquest with round battle units",
  "game_type": "real_time_node_conquest",
