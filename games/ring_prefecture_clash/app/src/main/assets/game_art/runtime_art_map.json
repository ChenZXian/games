        "x": 0.18,
        "y": 0.18,
        "w": 0.64,
        "h": 0.64
      },
      "z_order": "stream_above_route",
      "states": [
        "idle",
        "move",
        "attack",
        "capture",
        "defeat"
      ],
      "animation_rule": "Alternate frame swap every stream phase to create bounce cadence.",
      "movement_rule": "Streams interpolate between connected nodes with speed modifiers from rail and port nodes."
    },
    {
      "entity_key": "enemy_round_units",
      "role": "enemy",
      "asset_keys": [
        "game_art/ring_prefecture_tokens/enemy_round_a.png",
        "game_art/ring_prefecture_tokens/enemy_round_b.png"
      ],
      "default_facing": "movement_vector",
      "facing_rule": "Enemy streams mirror the same alternating bounce cadence while route color and badge imply pressure direction.",
      "anchor": {
        "x": 0.5,
        "y": 0.5
      },
      "hitbox": {
        "x": 0.18,
        "y": 0.18,
        "w": 0.64,
        "h": 0.64
      },
      "z_order": "stream_above_route",
      "states": [
        "idle",
        "move",
        "attack",
        "capture",
        "defeat"
      ],
      "animation_rule": "Alternate frame swap every stream phase to create bounce cadence.",
      "movement_rule": "Enemy streams interpolate between connected nodes using AI route selection."
    },
    {
