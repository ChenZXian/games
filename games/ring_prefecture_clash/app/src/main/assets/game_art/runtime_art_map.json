      "role": "building",
      "asset_keys": [
        "game_art/ring_prefecture_tokens/node_capital.png",
        "game_art/ring_prefecture_tokens/node_city.png",
        "game_art/ring_prefecture_tokens/node_rail.png",
        "game_art/ring_prefecture_tokens/node_shrine.png",
        "game_art/ring_prefecture_tokens/node_port.png"
