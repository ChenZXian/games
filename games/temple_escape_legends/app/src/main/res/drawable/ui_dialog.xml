<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#B3000000" />
        </shape>
    </item>
    <item
        android:left="20dp"
        android:top="72dp"
        android:right="20dp"
        android:bottom="72dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#F0151530"
                android:endColor="#EC0B0B1E"
                android:angle="270" />
            <stroke android:width="@dimen/cst_stroke_s" android:color="#8A5555AA" />
            <corners android:radius="@dimen/cst_radius_xl" />
            <padding
                android:left="@dimen/cst_pad_24"
                android:top="@dimen/cst_pad_24"
                android:right="@dimen/cst_pad_24"
                android:bottom="@dimen/cst_pad_24" />
        </shape>
    </item>
</layer-list>
