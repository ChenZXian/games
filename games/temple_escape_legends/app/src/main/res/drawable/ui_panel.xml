<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#66000000" />
            <corners android:radius="@dimen/cst_radius_l" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#E0181830"
                android:endColor="#D0101024"
                android:angle="270" />
            <stroke android:width="@dimen/cst_stroke_s" android:color="#704C4C7A" />
            <corners android:radius="@dimen/cst_radius_l" />
        </shape>
    </item>
</layer-list>
