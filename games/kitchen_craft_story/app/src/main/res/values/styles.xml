<resources>
    <style name="TextAppearance.Game" parent="@android:style/TextAppearance">
        <item name="android:textColor">@color/cst_text_primary</item>
        <item name="android:textSize">@dimen/cst_text_m</item>
    </style>
    <style name="TextAppearance.Game.Title"><item name="android:textColor">@color/cst_text_primary</item><item name="android:textSize">@dimen/cst_text_xxl</item><item name="android:textStyle">bold</item></style>
    <style name="TextAppearance.Game.Subtitle"><item name="android:textColor">@color/cst_text_secondary</item><item name="android:textSize">@dimen/cst_text_l</item><item name="android:textStyle">bold</item></style>
    <style name="TextAppearance.Game.Body"><item name="android:textColor">@color/cst_text_primary</item><item name="android:textSize">@dimen/cst_text_m</item></style>
    <style name="TextAppearance.Game.Caption"><item name="android:textColor">@color/cst_text_muted</item><item name="android:textSize">@dimen/cst_text_s</item></style>
    <style name="TextAppearance.Game.HudValue"><item name="android:textColor">@color/cst_text_primary</item><item name="android:textSize">@dimen/cst_text_l</item><item name="android:textStyle">bold</item></style>
    <style name="TextAppearance.Game.HudLabel"><item name="android:textColor">@color/cst_text_muted</item><item name="android:textSize">@dimen/cst_text_s</item></style>
    <style name="Widget.Game" parent="@android:style/Widget" />
    <style name="Widget.Game.Button" />
    <style name="Widget.Game.Button.Primary"><item name="android:background">@drawable/ui_button_primary</item><item name="android:textColor">@color/cst_text_on_primary</item><item name="android:textSize">@dimen/cst_text_m</item><item name="android:textStyle">bold</item></style>
    <style name="Widget.Game.Button.Secondary"><item name="android:background">@drawable/ui_button_secondary</item><item name="android:textColor">@color/cst_text_on_secondary</item><item name="android:textSize">@dimen/cst_text_m</item></style>
    <style name="Widget.Game.Button.Icon"><item name="android:background">@drawable/ui_button_icon</item></style>
    <style name="Widget.Game.Panel"><item name="android:background">@drawable/ui_panel</item></style>
    <style name="Widget.Game.Card"><item name="android:background">@drawable/ui_card</item></style>
    <style name="Widget.Game.Chip"><item name="android:background">@drawable/ui_chip</item></style>
    <style name="Widget.Game.Badge"><item name="android:background">@drawable/ui_badge</item></style>
    <style name="Widget.Game.Meter"><item name="android:background">@drawable/ui_meter_track</item></style>
</resources>
