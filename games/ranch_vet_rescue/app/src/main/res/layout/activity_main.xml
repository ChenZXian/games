<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cst_bg_main">

    <com.android.boot.GameView
        android:id="@+id/game_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/cst_playfield_reserve_left"
        android:paddingTop="@dimen/cst_playfield_reserve_top"
        android:paddingEnd="@dimen/cst_playfield_reserve_right"
        android:paddingBottom="@dimen/cst_playfield_reserve_bottom" />

    <LinearLayout
        android:id="@+id/menu_overlay"
        android:layout_width="430dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/ui_dialog"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/cst_pad_20">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/menu_title"
            android:textAppearance="@style/TextAppearance.Game.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cst_pad_8"
            android:gravity="center"
            android:text="@string/menu_subtitle"
            android:textAppearance="@style/TextAppearance.Game.Body" />

        <Button
            android:id="@+id/start_button"
            style="@style/Widget.Game.Button.Primary"
            android:layout_width="210dp"
            android:layout_height="52dp"
            android:layout_marginTop="@dimen/cst_pad_20"
            android:text="@string/btn_start" />

        <Button
            android:id="@+id/help_button"
            style="@style/Widget.Game.Button.Secondary"
            android:layout_width="210dp"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/cst_pad_8"
            android:text="@string/btn_how_to_play" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pause_overlay"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/ui_dialog"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/cst_pad_20"
        android:visibility="gone">

        <TextView
            android:id="@+id/pause_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Paused"
            android:textAppearance="@style/TextAppearance.Game.Title" />

        <Button
            android:id="@+id/resume_button"
            style="@style/Widget.Game.Button.Primary"
            android:layout_width="200dp"
            android:layout_height="52dp"
            android:layout_marginTop="@dimen/cst_pad_16"
            android:text="@string/btn_resume" />

        <Button
            android:id="@+id/restart_button"
            style="@style/Widget.Game.Button.Secondary"
            android:layout_width="200dp"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/cst_pad_8"
            android:text="@string/btn_restart" />
    </LinearLayout>

    <Button
        android:id="@+id/pause_button"
        style="@style/Widget.Game.Button.Icon"
        android:layout_width="56dp"
        android:layout_height="48dp"
        android:layout_gravity="top|right"
        android:layout_margin="@dimen/cst_pad_10"
        android:text="II"
        android:visibility="gone" />
</FrameLayout>
