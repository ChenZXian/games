<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance" parent="@android:style/TextAppearance" />
    <style name="TextAppearance.Game" parent="@android:style/TextAppearance" />
    <style name="Widget" parent="@android:style/Widget" />
    <style name="Widget.Game" parent="@android:style/Widget" />
    <style name="TextAppearance.Game.Title" parent="@android:style/TextAppearance.Material.Large">
        <item name="android:textColor">@color/cst_text_primary</item>
        <item name="android:textSize">@dimen/cst_text_xxl</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Game.Subtitle" parent="@android:style/TextAppearance.Material.Medium">
        <item name="android:textColor">@color/cst_text_secondary</item>
        <item name="android:textSize">@dimen/cst_text_l</item>
    </style>
    <style name="TextAppearance.Game.Body" parent="@android:style/TextAppearance.Material">
        <item name="android:textColor">@color/cst_text_primary</item>
        <item name="android:textSize">@dimen/cst_text_m</item>
    </style>
    <style name="TextAppearance.Game.Caption" parent="@android:style/TextAppearance.Material.Small">
        <item name="android:textColor">@color/cst_text_muted</item>
        <item name="android:textSize">@dimen/cst_text_s</item>
    </style>
    <style name="TextAppearance.Game.HudValue" parent="@android:style/TextAppearance.Material.Medium">
        <item name="android:textColor">@color/cst_text_primary</item>
        <item name="android:textSize">@dimen/cst_text_m</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Game.HudLabel" parent="@android:style/TextAppearance.Material.Small">
        <item name="android:textColor">@color/cst_text_secondary</item>
        <item name="android:textSize">@dimen/cst_text_xs</item>
    </style>
    <style name="Widget.Game.Button.Primary" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/ui_button_primary</item>
        <item name="android:textColor">@color/cst_text_on_primary</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">@dimen/cst_pad_12</item>
        <item name="android:paddingRight">@dimen/cst_pad_12</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.Game.Button.Secondary" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/ui_button_secondary</item>
        <item name="android:textColor">@color/cst_text_on_secondary</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">@dimen/cst_pad_12</item>
        <item name="android:paddingRight">@dimen/cst_pad_12</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.Game.Button.Icon" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/ui_button_icon</item>
        <item name="android:textColor">@color/cst_text_on_secondary</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.Game.Panel">
        <item name="android:background">@drawable/ui_panel</item>
        <item name="android:padding">@dimen/cst_pad_12</item>
    </style>
    <style name="Widget.Game.Card">
        <item name="android:background">@drawable/ui_card</item>
        <item name="android:padding">@dimen/cst_pad_10</item>
    </style>
    <style name="Widget.Game.Chip">
        <item name="android:background">@drawable/ui_chip</item>
        <item name="android:paddingLeft">@dimen/cst_pad_8</item>
        <item name="android:paddingRight">@dimen/cst_pad_8</item>
    </style>
    <style name="Widget.Game.Badge">
        <item name="android:background">@drawable/ui_badge</item>
        <item name="android:paddingLeft">@dimen/cst_pad_8</item>
        <item name="android:paddingRight">@dimen/cst_pad_8</item>
    </style>
    <style name="Widget.Game.Meter">
        <item name="android:background">@drawable/ui_meter_track</item>
    </style>
</resources>
