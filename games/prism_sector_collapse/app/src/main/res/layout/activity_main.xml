<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_stage_grid">

    <LinearLayout
        android:id="@+id/gameplay_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/cst_pad_12">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ui_panel_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/cst_pad_10">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/objective_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_goal"
                    android:textColor="@color/cst_text_secondary"
                    android:textSize="@dimen/cst_text_s" />

                <TextView
                    android:id="@+id/objective_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cst_pad_2"
                    android:textColor="@color/cst_text_primary"
                    android:textSize="@dimen/cst_text_m"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/score_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/cst_text_primary"
                android:textSize="@dimen/cst_text_l"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/cst_pad_10"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="62dp"
                android:layout_height="match_parent"
                android:background="@drawable/ui_panel"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="@dimen/cst_pad_12"
                android:paddingBottom="@dimen/cst_pad_12">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_chapter"
                    android:textColor="@color/cst_text_secondary"
                    android:textSize="@dimen/cst_text_s" />

                <TextView
                    android:id="@+id/chapter_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cst_pad_4"
                    android:textColor="@color/cst_text_primary"
                    android:textSize="@dimen/cst_text_l"
                    android:textStyle="bold" />

                <View
                    android:layout_width="28dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/cst_pad_12"
                    android:background="@drawable/ui_divider" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cst_pad_12"
                    android:text="@string/label_combo"
                    android:textColor="@color/cst_text_secondary"
                    android:textSize="@dimen/cst_text_s" />

                <TextView
                    android:id="@+id/combo_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cst_pad_4"
                    android:textColor="@color/cst_accent_2"
                    android:textSize="@dimen/cst_text_l"
                    android:textStyle="bold" />

                <View
                    android:layout_width="24dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Charge"
                    android:textColor="@color/cst_text_secondary"
                    android:textSize="@dimen/cst_text_s" />

                <FrameLayout
                    android:layout_width="18dp"
                    android:layout_height="120dp"
                    android:layout_marginTop="@dimen/cst_pad_6"
                    android:background="@drawable/ui_meter_track">

                    <View
                        android:id="@+id/chain_meter_fill"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_gravity="bottom"
                        android:background="@drawable/ui_meter_fill" />
                </FrameLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/board_shell"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/cst_pad_8"
                android:layout_marginEnd="@dimen/cst_pad_8"
                android:layout_weight="1"
                android:background="@drawable/ui_panel"
                android:padding="@dimen/cst_pad_6">

                <com.android.boot.ui.GameView
                    android:id="@+id/board_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="74dp"
                android:layout_height="match_parent"
                android:background="@drawable/ui_panel"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="@dimen/cst_pad_12"
                android:paddingBottom="@dimen/cst_pad_12">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_moves"
                    android:textColor="@color/cst_text_secondary"
                    android:textSize="@dimen/cst_text_s" />

                <TextView
                    android:id="@+id/moves_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cst_pad_4"
                    android:textColor="@color/cst_text_primary"
                    android:textSize="@dimen/cst_text_xl"
                    android:textStyle="bold" />

                <View
                    android:layout_width="30dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/cst_pad_12"
                    android:background="@drawable/ui_divider" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cst_pad_12"
                    android:text="@string/label_stage"
                    android:textColor="@color/cst_text_secondary"
                    android:textSize="@dimen/cst_text_s" />

                <TextView
                    android:id="@+id/stage_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cst_pad_4"
                    android:textColor="@color/cst_text_primary"
                    android:textSize="@dimen/cst_text_m"
                    android:textStyle="bold" />

                <View
                    android:layout_width="24dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btn_pause"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/ui_button_icon"
                    android:padding="10dp"
                    android:src="@drawable/ic_pause" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/screen_menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/cst_pad_24">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ui_panel"
            android:orientation="vertical"
            android:padding="@dimen/cst_pad_24">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prism Sector Collapse"
                android:textColor="@color/cst_text_primary"
                android:textSize="@dimen/cst_text_xxl"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cst_pad_8"
                android:text="Collapse giant color sectors, charge relay devices, and stabilize oversized prism boards."
                android:textColor="@color/cst_text_secondary"
                android:textSize="@dimen/cst_text_m" />

            <Button
                android:id="@+id/btn_start_game"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cst_pad_20"
                android:background="@drawable/ui_button_primary"
                android:text="@string/btn_start"
                android:textColor="@color/cst_text_on_primary" />

            <Button
                android:id="@+id/btn_chapter_map"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cst_pad_10"
                android:background="@drawable/ui_button_secondary"
                android:text="Sector Map"
                android:textColor="@color/cst_text_on_secondary" />

            <Button
                android:id="@+id/btn_guide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cst_pad_10"
                android:background="@drawable/ui_button_secondary"
                android:text="@string/btn_how_to_play"
                android:textColor="@color/cst_text_on_secondary" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/screen_map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cst_overlay_scrim"
        android:padding="@dimen/cst_pad_20"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ui_dialog"
            android:orientation="vertical"
            android:padding="@dimen/cst_pad_20">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sector Map"
                android:textColor="@color/cst_text_primary"
                android:textSize="@dimen/cst_text_xl"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cst_pad_8"
                android:text="Choose a reactor sector. Later sectors use larger boards and harder partition layouts."
                android:textColor="@color/cst_text_secondary"
                android:textSize="@dimen/cst_text_m" />

            <Button android:id="@+id/chapter_one" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cst_pad_16" android:background="@drawable/ui_button_primary" android:text="Sector 1  Opening Grid" android:textColor="@color/cst_text_on_primary" />
            <Button android:id="@+id/chapter_two" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cst_pad_10" android:background="@drawable/ui_button_secondary" android:text="Sector 2  Relay Spine" android:textColor="@color/cst_text_on_secondary" />
            <Button android:id="@+id/chapter_three" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cst_pad_10" android:background="@drawable/ui_button_secondary" android:text="Sector 3  Armor Array" android:textColor="@color/cst_text_on_secondary" />
            <Button android:id="@+id/chapter_four" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cst_pad_10" android:background="@drawable/ui_button_secondary" android:text="Sector 4  Split Chamber" android:textColor="@color/cst_text_on_secondary" />
            <Button android:id="@+id/chapter_five" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cst_pad_10" android:background="@drawable/ui_button_secondary" android:text="Sector 5  Core Surge" android:textColor="@color/cst_text_on_secondary" />
            <Button android:id="@+id/chapter_six" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cst_pad_10" android:background="@drawable/ui_button_secondary" android:text="Sector 6  Grand Collapse" android:textColor="@color/cst_text_on_secondary" />

            <Button
                android:id="@+id/btn_close_map"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cst_pad_16"
                android:background="@drawable/ui_button_secondary"
                android:text="@string/btn_menu"
                android:textColor="@color/cst_text_on_secondary" />
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:id="@+id/screen_guide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cst_overlay_scrim"
        android:padding="@dimen/cst_pad_20"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ui_dialog"
            android:orientation="vertical"
            android:padding="@dimen/cst_pad_20">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="How To Play"
                android:textColor="@color/cst_text_primary"
                android:textSize="@dimen/cst_text_xl"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cst_pad_12"
                android:text="Tap a connected cluster of four or more same-color cells to collapse it. Larger clusters raise charge and may create pulse cores. Armor blocks crack when nearby cells collapse. Relay nodes must be energized by adjacent clears. Hold on a cluster to preview its size."
                android:textColor="@color/cst_text_secondary"
                android:textSize="@dimen/cst_text_m" />

            <Button
                android:id="@+id/btn_close_guide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cst_pad_16"
                android:background="@drawable/ui_button_primary"
                android:text="@string/label_continue"
                android:textColor="@color/cst_text_on_primary" />
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/overlay_pause"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cst_overlay_scrim"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="@dimen/cst_pad_20"
            android:background="@drawable/ui_dialog"
            android:orientation="vertical"
            android:padding="@dimen/cst_pad_20">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paused"
                android:textColor="@color/cst_text_primary"
                android:textSize="@dimen/cst_text_xl"
                android:textStyle="bold" />

            <Button android:id="@+id/btn_resume_game" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cst_pad_16" android:background="@drawable/ui_button_primary" android:text="@string/btn_resume" android:textColor="@color/cst_text_on_primary" />
            <Button android:id="@+id/btn_restart_game" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cst_pad_10" android:background="@drawable/ui_button_secondary" android:text="@string/btn_restart" android:textColor="@color/cst_text_on_secondary" />
            <Button android:id="@+id/btn_quit_to_menu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cst_pad_10" android:background="@drawable/ui_button_secondary" android:text="@string/btn_menu" android:textColor="@color/cst_text_on_secondary" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/overlay_result"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cst_overlay_scrim"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="@dimen/cst_pad_20"
            android:background="@drawable/ui_dialog"
            android:orientation="vertical"
            android:padding="@dimen/cst_pad_20">

            <TextView android:id="@+id/result_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/cst_text_primary" android:textSize="@dimen/cst_text_xl" android:textStyle="bold" />
            <TextView android:id="@+id/result_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cst_pad_10" android:textColor="@color/cst_text_secondary" android:textSize="@dimen/cst_text_m" />
            <Button android:id="@+id/btn_next_stage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cst_pad_16" android:background="@drawable/ui_button_primary" android:text="@string/label_next" android:textColor="@color/cst_text_on_primary" />
            <Button android:id="@+id/btn_retry_stage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cst_pad_10" android:background="@drawable/ui_button_secondary" android:text="@string/btn_restart" android:textColor="@color/cst_text_on_secondary" />
            <Button android:id="@+id/btn_result_menu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cst_pad_10" android:background="@drawable/ui_button_secondary" android:text="@string/btn_menu" android:textColor="@color/cst_text_on_secondary" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
