<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/cst_bg_main"
                android:startColor="@color/cst_bg_alt" />
        </shape>
    </item>
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#112E537A" />
        </shape>
    </item>
</layer-list>
