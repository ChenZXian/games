<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cst_bg_main"
    android:padding="@dimen/cst_pad_8">

    <LinearLayout
        android:id="@+id/hudBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cst_hud_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/ui_panel_header"
        android:paddingLeft="@dimen/cst_pad_10"
        android:paddingRight="@dimen/cst_pad_10">

        <TextView
            android:id="@+id/oxygenText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.Game.HudValue"
            android:text="O2 100"
            android:background="@drawable/ui_chip"
            android:paddingLeft="@dimen/cst_pad_8"
            android:paddingRight="@dimen/cst_pad_8" />

        <TextView
            android:id="@+id/batteryText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.Game.HudValue"
            android:text="PWR 100"
            android:background="@drawable/ui_chip"
            android:paddingLeft="@dimen/cst_pad_8"
            android:paddingRight="@dimen/cst_pad_8"
            android:layout_marginLeft="@dimen/cst_pad_8" />

        <TextView
            android:id="@+id/partsText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.Game.HudValue"
            android:text="PARTS 0"
            android:background="@drawable/ui_chip"
            android:paddingLeft="@dimen/cst_pad_8"
            android:paddingRight="@dimen/cst_pad_8"
            android:layout_marginLeft="@dimen/cst_pad_8" />

        <TextView
            android:id="@+id/goalText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:textAppearance="@style/TextAppearance.Game.HudValue"
            android:text="REPAIR 0/6"
            android:background="@drawable/ui_chip"
            android:paddingLeft="@dimen/cst_pad_8"
            android:paddingRight="@dimen/cst_pad_8"
            android:layout_marginLeft="@dimen/cst_pad_8" />

        <Button
            android:id="@+id/pauseButton"
            style="@style/Widget.Game.Button.Icon"
            android:layout_width="78dp"
            android:layout_height="42dp"
            android:layout_marginLeft="@dimen/cst_pad_8"
            android:text="@string/btn_pause" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/playfieldFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/cst_pad_8"
        android:layout_marginBottom="@dimen/cst_pad_8">

        <com.android.boot.ui.GameView
            android:id="@+id/gameView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/menuPanel"
            style="@style/Widget.Game.Panel"
            android:layout_width="390dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Game.Title"
                android:text="Lunar Salvage Miner" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cst_pad_8"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Game.Body"
                android:text="Scan wreckage, recover O2 and power, and restore the launch dock." />

            <Button
                android:id="@+id/startButton"
                style="@style/Widget.Game.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="@dimen/cst_pad_16"
                android:text="@string/btn_start" />

            <Button
                android:id="@+id/restartButton"
                style="@style/Widget.Game.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="@dimen/cst_pad_8"
                android:text="@string/btn_restart" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cst_pad_8"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/helpButton"
                    style="@style/Widget.Game.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/btn_how_to_play" />

                <Button
                    android:id="@+id/soundButton"
                    style="@style/Widget.Game.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="@dimen/cst_pad_8"
                    android:text="@string/btn_mute" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/controlBar"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/ui_panel_header"
        android:paddingLeft="@dimen/cst_pad_8"
        android:paddingRight="@dimen/cst_pad_8">

        <Button
            android:id="@+id/leftButton"
            style="@style/Widget.Game.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:text="LEFT" />

        <Button
            android:id="@+id/scanButton"
            style="@style/Widget.Game.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginLeft="@dimen/cst_pad_8"
            android:text="SCAN" />

        <Button
            android:id="@+id/boostButton"
            style="@style/Widget.Game.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginLeft="@dimen/cst_pad_8"
            android:text="BOOST" />

        <Button
            android:id="@+id/rightButton"
            style="@style/Widget.Game.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginLeft="@dimen/cst_pad_8"
            android:text="RIGHT" />
    </LinearLayout>
</LinearLayout>
