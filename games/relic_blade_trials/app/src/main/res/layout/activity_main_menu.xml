<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cst_bg_main"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/app_name"
        android:textColor="@color/cst_text_primary"
        android:textSize="32sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_start_game"
        android:layout_width="220dp"
        android:layout_height="56dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/ui_button_primary"
        android:text="@string/menu_start_game"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="18sp" />

    <Button
        android:id="@+id/btn_how_to_play"
        android:layout_width="220dp"
        android:layout_height="56dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/ui_button_danger"
        android:text="@string/menu_how_to_play"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="18sp" />

    <Button
        android:id="@+id/btn_music_toggle"
        android:layout_width="220dp"
        android:layout_height="56dp"
        android:background="@drawable/ui_button_primary"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="18sp" />

</LinearLayout>
