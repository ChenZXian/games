<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cst_bg_main"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/menu_select_level"
        android:textColor="@color/cst_text_primary"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btn_back_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:padding="8dp"
        android:text="@string/action_back"
        android:textColor="@color/cst_accent_2"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btn_level_1"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/ui_button_primary"
        android:textAllCaps="false"
        android:textColor="@color/cst_text_on_primary"
        android:textSize="18sp" />

    <Button
        android:id="@+id/btn_level_2"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/ui_button_primary"
        android:textAllCaps="false"
        android:textColor="@color/cst_text_on_primary"
        android:textSize="18sp" />

    <Button
        android:id="@+id/btn_level_3"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/ui_button_primary"
        android:textAllCaps="false"
        android:textColor="@color/cst_text_on_primary"
        android:textSize="18sp" />

</LinearLayout>
