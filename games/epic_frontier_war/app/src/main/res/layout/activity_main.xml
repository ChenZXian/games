<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/cst_bg_main">

	<com.android.boot.ui.GameView
		android:id="@+id/game_view"
		android:layout_width="match_parent"
		android:layout_height="match_parent" />

	<LinearLayout
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="top|end"
		android:orientation="horizontal"
		android:padding="12dp">

		<ImageButton
			android:id="@+id/btn_help"
			android:layout_width="44dp"
			android:layout_height="44dp"
			android:background="@android:color/transparent"
			android:contentDescription="@string/btn_help"
			android:src="@drawable/ic_help" />

		<ImageButton
			android:id="@+id/btn_mute"
			android:layout_width="44dp"
			android:layout_height="44dp"
			android:layout_marginStart="8dp"
			android:background="@android:color/transparent"
			android:contentDescription="Mute"
			android:src="@drawable/ic_sound_on" />
	</LinearLayout>

	<LinearLayout
		android:id="@+id/start_overlay"
		android:layout_width="260dp"
		android:layout_height="wrap_content"
		android:layout_gravity="center"
		android:background="@color/cst_bg_panel"
		android:orientation="vertical"
		android:padding="16dp">

		<Button
			android:id="@+id/btn_start"
			style="@style/Widget.Game.Button.Primary"
			android:layout_width="match_parent"
			android:layout_height="54dp"
			android:text="@string/btn_start" />
	</LinearLayout>
</FrameLayout>
