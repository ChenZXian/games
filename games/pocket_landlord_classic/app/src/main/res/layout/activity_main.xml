<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cst_bg_main"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <LinearLayout
        android:id="@+id/headerPanel"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:background="@drawable/ui_panel_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/titleView"
                style="@style/TextTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pocket Landlord Classic" />

            <TextView
                android:id="@+id/subtitleView"
                style="@style/TextLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bronze Hall Table 1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chapterView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/ui_chip"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp"
                android:text="Hall 1"
                android:textColor="@color/cst_text_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/starView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/ui_chip"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp"
                android:text="Stars 0"
                android:textColor="@color/cst_text_primary"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/gameContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_weight="1"
        android:background="@drawable/ui_panel">

        <com.android.boot.ui.GameView
            android:id="@+id/gameView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp" />

        <LinearLayout
            android:id="@+id/menuOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/cst_overlay"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="@dimen/dialog_width"
                android:layout_height="wrap_content"
                android:background="@drawable/ui_dialog"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/TextTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rise Through The Halls" />

                <TextView
                    android:id="@+id/menuInfoView"
                    style="@style/TextLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Classic offline Dou Dizhu with campaign halls and drill puzzles." />

                <Button
                    android:id="@+id/startButton"
                    style="@style/GameButtonPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/btn_start" />

                <Button
                    android:id="@+id/drillButton"
                    style="@style/GameButtonSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/btn_drill" />

                <Button
                    android:id="@+id/howToPlayButton"
                    style="@style/GameButtonSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/btn_how_to_play" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pauseOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/cst_overlay"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="@dimen/dialog_width"
                android:layout_height="wrap_content"
                android:background="@drawable/ui_dialog"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/TextTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Round Paused" />

                <Button
                    android:id="@+id/resumeButton"
                    style="@style/GameButtonPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/btn_resume" />

                <Button
                    android:id="@+id/restartButton"
                    style="@style/GameButtonSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/btn_restart" />

                <Button
                    android:id="@+id/menuButton"
                    style="@style/GameButtonSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/btn_menu" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/resultOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/cst_overlay"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="@dimen/dialog_width"
                android:layout_height="wrap_content"
                android:background="@drawable/ui_dialog"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/resultTitleView"
                    style="@style/TextTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Round Clear" />

                <TextView
                    android:id="@+id/resultBodyView"
                    style="@style/TextLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Stars 0  Coins 0" />

                <Button
                    android:id="@+id/nextButton"
                    style="@style/GameButtonPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/btn_next" />

                <Button
                    android:id="@+id/resultMenuButton"
                    style="@style/GameButtonSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/btn_menu" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/helpOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/cst_overlay"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="@dimen/dialog_width"
                android:layout_height="wrap_content"
                android:background="@drawable/ui_dialog"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/TextTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="How To Play" />

                <TextView
                    android:id="@+id/helpTextView"
                    style="@style/TextLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Call the score, become landlord, then empty your hand with legal combinations. Tap cards to select, drag across runs, use Hint for a safe response, and save bombs for swing turns." />

                <Button
                    android:id="@+id/helpCloseButton"
                    style="@style/GameButtonPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/btn_resume" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/action_bar_height"
        android:background="@drawable/ui_panel_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <Button
            android:id="@+id/actionOneButton"
            style="@style/GameButtonSecondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_play" />

        <Button
            android:id="@+id/actionTwoButton"
            style="@style/GameButtonSecondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/btn_pass" />

        <Button
            android:id="@+id/actionThreeButton"
            style="@style/GameButtonSecondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/btn_hint" />

        <Button
            android:id="@+id/actionFourButton"
            style="@style/GameButtonSecondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/btn_sort" />

        <ImageButton
            android:id="@+id/pauseIconButton"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/ui_button_icon"
            android:padding="10dp"
            android:src="@drawable/ic_pause"
            android:tint="@color/cst_text_primary" />
    </LinearLayout>
</LinearLayout>
