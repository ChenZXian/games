<resources>
    <style name="TextTitle">
        <item name="android:textColor">@color/cst_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
    </style>
    <style name="TextLabel">
        <item name="android:textColor">@color/cst_text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="TextValue">
        <item name="android:textColor">@color/cst_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="GameButtonPrimary">
        <item name="android:background">@drawable/ui_button_primary</item>
        <item name="android:textColor">@color/cst_text_dark</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>
    <style name="GameButtonSecondary">
        <item name="android:background">@drawable/ui_button_secondary</item>
        <item name="android:textColor">@color/cst_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>
    <style name="GamePanel">
        <item name="android:background">@drawable/ui_panel</item>
        <item name="android:padding">12dp</item>
    </style>
</resources>
