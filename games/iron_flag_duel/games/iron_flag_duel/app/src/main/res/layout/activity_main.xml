<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cst_bg_main">

    <com.android.boot.ui.GameSurfaceView
        android:id="@+id/game_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/hud_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/ui_panel"
        android:orientation="horizontal"
        android:padding="@dimen/cst_pad_8">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_phase"
                style="@style/TextAppearance.Game.HudValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deployment" />

            <TextView
                android:id="@+id/txt_turn"
                style="@style/TextAppearance.Game.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Turn: Player" />
        </LinearLayout>

        <TextView
            android:id="@+id/txt_ai"
            style="@style/Widget.Game.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="AI Idle"
            android:textColor="@color/cst_text_primary" />

        <ImageButton
            android:id="@+id/btn_pause"
            style="@style/Widget.Game.Button.Icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/cst_pad_8"
            android:contentDescription="@string/btn_resume"
            android:src="@drawable/ic_pause" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panel_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/ui_dialog"
        android:orientation="vertical"
        android:padding="@dimen/cst_pad_10">

        <TextView
            android:id="@+id/txt_status"
            style="@style/TextAppearance.Game.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Flip one hidden piece or move one revealed piece." />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panel_menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cst_overlay_scrim"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/cst_pad_24">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ui_dialog"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/cst_pad_20">

            <TextView
                style="@style/TextAppearance.Game.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Iron Flag Duel" />

            <TextView
                style="@style/TextAppearance.Game.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cst_pad_8"
                android:text="Hidden information land battle chess" />

            <Button
                android:id="@+id/btn_start"
                style="@style/Widget.Game.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cst_pad_20"
                android:text="@string/btn_start" />

            <Button
                android:id="@+id/btn_help"
                style="@style/Widget.Game.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cst_pad_8"
                android:text="@string/btn_how_to_play" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panel_pause"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cst_overlay_scrim"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/cst_pad_24">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ui_dialog"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/cst_pad_20">

            <TextView
                style="@style/TextAppearance.Game.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paused" />

            <Button
                android:id="@+id/btn_resume"
                style="@style/Widget.Game.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cst_pad_16"
                android:text="@string/btn_resume" />

            <Button
                android:id="@+id/btn_restart"
                style="@style/Widget.Game.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cst_pad_8"
                android:text="@string/btn_restart" />

            <Button
                android:id="@+id/btn_menu"
                style="@style/Widget.Game.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cst_pad_8"
                android:text="@string/btn_menu" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panel_result"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cst_overlay_scrim"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/cst_pad_24">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ui_dialog"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/cst_pad_20">

            <TextView
                android:id="@+id/txt_result_title"
                style="@style/TextAppearance.Game.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Victory" />

            <TextView
                android:id="@+id/txt_result_detail"
                style="@style/TextAppearance.Game.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cst_pad_8"
                android:text="Enemy flag captured." />

            <Button
                android:id="@+id/btn_new_match"
                style="@style/Widget.Game.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cst_pad_16"
                android:text="@string/btn_new_match" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
